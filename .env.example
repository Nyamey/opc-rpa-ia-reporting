# Modèle de configuration locale.
# Copiez ce fichier sous le nom .env à la racine du projet, puis renseignez
# vos valeurs. Le fichier .env ne doit jamais être versionné.

# Adresse du service de modèle de langage.
# Tant que cette variable reste vide, la classification des écarts s'appuie
# uniquement sur les règles déterministes, ce qui reste un mode de
# fonctionnement complet et supporté.
LLM_API_URL=

# Jeton d'authentification transmis dans l'en-tête Authorization.
LLM_API_KEY=

# Identifiant du modèle sollicité.
LLM_MODEL=claude-sonnet-5

# Délai maximal d'attente d'une réponse, en secondes.
LLM_TIMEOUT=30

# Niveau de journalisation : DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO
